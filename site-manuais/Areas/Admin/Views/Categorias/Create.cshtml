@model site_manuais.Models.Categoria

@{
    ViewData["Title"] = "Create";
}



<div class="form-container">
     <h1>EDITAR</h1>

     <h4>Categoria</h4>
     <hr/>
     <div class="container-fluid px-0">

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Descricao" class="control-label"></label>
                <input asp-for="Descricao" class="form-control" />
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Cor" class="form-label">Cor da Categoria</label>
                <div class="d-flex gap-5">
                    <label>
                        <input type="radio" asp-for="Cor" value="#cc0606" checked="@(Model?.Cor == "#cc0606")" />
                        <span style="display:inline-block;width:24px;height:24px;background:#cc0606;border-radius:50%;border:2px solid #cccccc;"></span>
                        Vermelho
                    </label>
                    <label>
                        <input type="radio" asp-for="Cor" value="#0202a1" checked="@(Model?.Cor == "#0202a1")" />
                        <span style="display:inline-block;width:24px;height:24px;background:#0202a1;border-radius:50%;border:2px solid #cccccc;"></span>
                        Azul
                    </label>
                    <label>
                        <input type="radio" asp-for="Cor" value="#0b6b04" checked="@(Model?.Cor == "#0b6b04")" />
                        <span style="display:inline-block;width:24px;height:24px;background:#0b6b04;border-radius:50%;border:2px solid #cccccc;"></span>
                        Verde
                    </label>
                    <label>
                        <input type="radio" asp-for="Cor" value="#ff7f2a" checked="@(Model?.Cor == "#ff7f2a")" />
                        <span style="display:inline-block;width:24px;height:24px;background:#ff7f2a;border-radius:50%;border:2px solid #cccccc;"></span>
                        Laranja
                    </label>
                    <label>
                        <input type="radio" asp-for="Cor" value="#520152" checked="@(Model?.Cor == "#520152")" />
                        <span style="display:inline-block;width:24px;height:24px;background:#520152;border-radius:50%;border:2px solid #cccccc;"></span>
                        Roxo
                    </label>
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Criar" class="btn btn-primary" />
            </div>
        </form>
        <div>
        <a asp-action="Index">Voltar</a>
        </div>
     </div>
   </div>
</>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
