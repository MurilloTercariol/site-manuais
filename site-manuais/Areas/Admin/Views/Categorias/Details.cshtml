@model site_manuais.Models.Categoria

@{
    ViewData["Title"] = "Detalhes da Categoria";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="display-4">
                <i class="bi bi-folder"></i> Detalhes da Categoria
            </h1>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title mb-4">
                        <span class="color-badge" style="background-color: @Model.Cor;"></span>
                        @Model.Nome
                    </h3>

                    <dl class="row">
                        <dt class="col-sm-3">Descrição:</dt>
                        <dd class="col-sm-9">@(Model.Descricao ?? "—")</dd>

                        <dt class="col-sm-3">Cor:</dt>
                        <dd class="col-sm-9">
                            <span class="color-badge" style="background-color: @Model.Cor;"></span>
                            @Model.Cor
                        </dd>

                        <dt class="col-sm-3">Data de Criação:</dt>
                        <dd class="col-sm-9">
                            <i class="bi bi-calendar-plus"></i>
                            @Model.DataCriacao.ToString("dd/MM/yyyy HH:mm")
                        </dd>

                        @if (Model.DataUltimaAlteracao.HasValue)
                        {
                            <dt class="col-sm-3">Última Alteração:</dt>
                            <dd class="col-sm-9">
                                <i class="bi bi-pencil-square"></i>
                                @Model.DataUltimaAlteracao.Value.ToString("dd/MM/yyyy HH:mm")
                            </dd>
                        }

                        <dt class="col-sm-3">Módulos:</dt>
                        <dd class="col-sm-9">
                            @if (Model.Modulos != null && Model.Modulos.Any())
                            {
                                <span class="badge bg-primary">@Model.Modulos.Count() módulo(s)</span>
                            }
                            else
                            {
                                <span class="text-muted">Nenhum módulo cadastrado</span>
                            }
                        </dd>
                    </dl>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-between mt-4">
                        <div>
                            <a asp-area="Admin" asp-controller="Modulos" asp-action="Index" class="btn btn-info">
                                <i class="bi bi-grid-3x3"></i> Ver Módulos
                            </a>
                        </div>
                        <div>
                            <a asp-area="Admin" asp-controller="Categorias" asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Voltar
                            </a>
                            <a asp-area="Admin" asp-controller="Categorias" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                            <a asp-area="Admin" asp-controller="Categorias" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Deletar
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-info-circle"></i> Informações
                    </h5>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success"></i>
                            Categoria criada em @Model.DataCriacao.ToString("dd/MM/yyyy")
                        </li>
                        @if (Model.DataUltimaAlteracao.HasValue)
                        {
                            <li class="mb-2">
                                <i class="bi bi-pencil-square text-warning"></i>
                                Última alteração em @Model.DataUltimaAlteracao.Value.ToString("dd/MM/yyyy HH:mm")
                            </li>
                        }
                        @if (Model.Modulos != null && Model.Modulos.Any())
                        {
                            <li class="mb-2">
                                <i class="bi bi-folder text-primary"></i>
                                Contém @Model.Modulos.Count() módulo(s)
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .color-badge {
        display: inline-block;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        margin-right: 8px;
        vertical-align: middle;
    }
</style>
