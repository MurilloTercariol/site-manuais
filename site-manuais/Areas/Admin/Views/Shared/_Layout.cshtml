<!DOCTYPE html>
<html lang="pt-BR" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin | TZ Soluções</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/site_manuais.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        .admin-sidebar {
            min-height: calc(100vh - 56px);
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .admin-content {
            min-height: calc(100vh - 56px - 100px); /* 56px navbar + 100px footer aproximado */
        }

        .sidebar-link {
            color: rgba(255,255,255,0.8) !important;
            padding: 12px 20px;
            border-radius: 8px;
            margin: 5px 10px;
            transition: all 0.3s;
        }

            .sidebar-link:hover, .sidebar-link.active {
                background-color: rgba(255,255,255,0.15);
                color: white !important;
                transform: translateX(5px);
            }

        /* Estrutura flexbox para admin */
        body.admin-layout {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .admin-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .admin-main-content {
            flex: 1;
        }
    </style>
</head>
<body class="admin-layout">
    <!-- NAVBAR ADMIN -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container-fluid">
            <!-- LOGO ADMIN -->
            <a class="navbar-brand fw-bold" href="#" onclick="toggleSidebar()">
                <i class="bi bi-list me-2"></i>
                <i class="bi bi-gear-fill text-warning me-2"></i>
                Painel Administrativo
            </a>

            <!-- LOGO SEM REDIRECIONAMENTO -->
            <span class="navbar-brand fw-bold mb-0">
                <i class="bi bi-gear-fill text-warning me-2"></i>
                    Painel Administrativo - TZ Soluções
                </span>
            </div>

            <!-- MENU USUÁRIO -->
            <div class="navbar-nav ms-auto">
                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle text-light" href="#" id="userDropdown"
                       role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle me-1"></i>
                        @User.Identity.Name
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" asp-controller="Public" asp-action="Index" asp-area="">
                                <i class="bi bi-globe me-2"></i> Ver Site Público
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form method="post" action="/Account/Logout" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-right me-2"></i> Sair
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <div class="admin-wrapper">
        <div class="admin-main-content">
            <div class="container-fluid p-0">
                <div class="row g-0">
                    <!-- SIDEBAR -->
                    <div class="col-md-3 col-lg-2 admin-sidebar" id="sidebar">
                        <div class="p-3">
                            <h6 class="text-white-50 text-uppercase small fw-bold mb-3">Menu Principal</h6>

                            <a asp-area="Admin" asp-controller="Categorias" asp-action="Index"
                               class="sidebar-link d-block text-decoration-none">
                                <i class="bi bi-folder me-2"></i> Categorias
                            </a>

                            <a asp-area="Admin" asp-controller="Modulos" asp-action="Index"
                               class="sidebar-link d-block text-decoration-none">
                                <i class="bi bi-grid-3x3 me-2"></i> Módulos
                            </a>

                            <a asp-area="Admin" asp-controller="Documentos" asp-action="Index"
                               class="sidebar-link d-block text-decoration-none">
                                <i class="bi bi-file-earmark-pdf me-2"></i> Documentos
                            </a>

                            <hr class="my-3" style="border-color: rgba(255,255,255,0.2);">

                            <h6 class="text-white-50 text-uppercase small fw-bold mb-3">Ações Rápidas</h6>

                            <a asp-area="Admin" asp-controller="Categorias" asp-action="Create"
                               class="sidebar-link d-block text-decoration-none">
                                <i class="bi bi-plus-circle me-2"></i> Nova Categoria
                            </a>

                            <a asp-area="Admin" asp-controller="Documentos" asp-action="Create"
                               class="sidebar-link d-block text-decoration-none">
                                <i class="bi bi-cloud-upload me-2"></i> Upload Documento
                            </a>
                        </div>
                    </div>

                    <!-- CONTEÚDO PRINCIPAL -->
                    <div class="col-md-9 col-lg-10 admin-content">
                        <div class="p-4">
                            <!-- BREADCRUMB -->
                            <nav aria-label="breadcrumb" class="mb-4">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item">
                                        <a asp-area="Admin" asp-controller="Home" asp-action="Index">
                                            <i class="bi bi-house"></i> Admin
                                        </a>
                                    </li>
                                    @if (ViewData["Title"] != null)
                                    {
                                        <li class="breadcrumb-item active">@ViewData["Title"]</li>
                                    }
                                </ol>
                            </nav>

                            <!-- CONTEÚDO DA PÁGINA -->
                            @RenderBody()
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- FOOTER ADMIN -->
        <footer class="bg-secondary text-light py-3 mt-auto">
            <div class="container-fluid">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <small>
                            <i class="bi bi-shield-check me-1"></i>
                            <strong>Área Administrativa</strong> - TZ Soluções
                        </small>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <small class="text-light">
                            <i class="bi bi-person-circle me-1"></i>
                            Logado como: <strong>@User.Identity.Name</strong> |
                            <i class="bi bi-clock me-1"></i>
                            @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                        </small>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Função para alternar sidebar em dispositivos móveis
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('d-none');
        }

        // Marcar link ativo no sidebar
        document.addEventListener('DOMContentLoaded', function() {
            const currentPath = window.location.pathname;
            const sidebarLinks = document.querySelectorAll('.sidebar-link');

            sidebarLinks.forEach(link => {
                if (currentPath.startsWith(link.getAttribute('href'))) {
                    link.classList.add('active');
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>