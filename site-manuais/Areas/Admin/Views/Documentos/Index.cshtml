@model IEnumerable<site_manuais.Models.Documento>

@{
    ViewData["Title"] = "Documentos";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="display-4">
                <i class="bi bi-file-earmark-pdf"></i> Documentos
            </h1>
            <p class="text-muted">Gerencie os documentos PDF do sistema</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-12">
            <a asp-area="Admin" asp-controller="Documentos" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-cloud-upload"></i> Enviar Novo Documento
            </a>
            <a asp-area="Admin" asp-controller="Modulos" asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Voltar para Módulos
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row">
            <div class="col-md-12">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Título</th>
                                <th>Módulo</th>
                                <th>Categoria</th>
                                <th>Tamanho</th>
                                <th>Upload</th>
                                <th>Última alteração</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <i class="bi bi-file-pdf text-danger"></i>
                                        <strong>@item.Titulo</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">@item.Modulo.Nome</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@item.Modulo.Categoria.Nome</span>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            @{
                                                var tamanhoKB = item.TamanhoArquivo / 1024.0;
                                                var tamanhoMB = tamanhoKB / 1024.0;
                                                var tamanhoFormatado = tamanhoMB >= 1 
                                                    ? $"{tamanhoMB:F2} MB" 
                                                    : $"{tamanhoKB:F2} KB";
                                            }
                                            @tamanhoFormatado
                                        </small>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            <i class="bi bi-calendar-plus"></i>
                                            @item.DataUpload.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    </td>
                                    <td>
                                        @if (item.DataUltimaAlteracao.HasValue)
                                        {
                                            <small class="text-muted">
                                                <i class="bi bi-pencil-square"></i>
                                                @item.DataUltimaAlteracao.Value.ToString("dd/MM/yyyy HH:mm")
                                            </small>
                                        }
                                        else
                                        {
                                            <small class="text-muted">—</small>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-area="Admin" asp-action="Download" asp-route-id="@item.Id" 
                                               class="btn btn-sm btn-success" title="Download">
                                                <i class="bi bi-download"></i>
                                            </a>
                                            <a asp-area="Admin" asp-action="Details" asp-route-id="@item.Id" 
                                               class="btn btn-sm btn-info" title="Ver Detalhes">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-area="Admin" asp-action="Edit" asp-route-id="@item.Id" 
                                               class="btn btn-sm btn-warning" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-area="Admin" asp-action="Delete" asp-route-id="@item.Id" 
                                               class="btn btn-sm btn-danger" title="Deletar">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i> 
            <strong>Nenhum documento cadastrado.</strong> 
            Clique no botão acima para enviar o primeiro documento.
        </div>
    }
</div>
