@model site_manuais.Models.Documento

@{
    ViewData["Title"] = "Editar Documento";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="display-4">
                <i class="bi bi-pencil-square"></i> Editar Documento
            </h1>
            <p class="text-muted">Atualize as informações ou substitua o arquivo PDF</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-area="Admin" asp-controller="Documentos" asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CaminhoArquivo" />
                        <input type="hidden" asp-for="NomeArquivoOriginal" />
                        <input type="hidden" asp-for="TamanhoArquivo" />
                        <input type="hidden" asp-for="DataUpload" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="ModuloId" class="form-label">Módulo *</label>
                            <select asp-for="ModuloId" class="form-select" asp-items="ViewBag.ModuloId"></select>
                            <span asp-validation-for="ModuloId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Titulo" class="form-label">Título do Documento *</label>
                            <input asp-for="Titulo" class="form-control" />
                            <span asp-validation-for="Titulo" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descricao" class="form-label">Descrição (Opcional)</label>
                            <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Descricao" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Arquivo Atual</label>
                            <div class="input-group">
                                <input type="text" class="form-control" value="@Model.NomeArquivoOriginal" readonly />
                                <a asp-area="Admin" asp-action="Download" asp-route-id="@Model.Id" class="btn btn-outline-success" target="_blank">
                                    <i class="bi bi-download"></i> Download
                                </a>
                            </div>
                            <div class="form-text">
                                @{
                                    var tamanhoKB = Model.TamanhoArquivo / 1024.0;
                                    var tamanhoMB = tamanhoKB / 1024.0;
                                    var tamanhoFormatado = tamanhoMB >= 1
                                    ? $"{tamanhoMB:F2} MB"
                                    : $"{tamanhoKB:F2} KB";
                                }
                                Tamanho: @tamanhoFormatado
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="arquivo" class="form-label">Substituir Arquivo (Opcional)</label>
                            <input type="file" class="form-control" id="arquivo" name="arquivo" accept=".pdf,application/pdf" />
                            <div class="form-text">Deixe em branco para manter o arquivo atual | Tamanho máximo: 10MB</div>
                            <span class="text-danger">@ViewData.ModelState["arquivo"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-area="Admin" asp-controller="Documentos" asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Salvar Alterações
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-info-circle"></i> Informações
                    </h5>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <strong>Enviado em:</strong><br>
                            <small class="text-muted">@Model.DataUpload.ToString("dd/MM/yyyy HH:mm")</small>
                        </li>
                        @if (Model.DataUltimaAlteracao.HasValue)
                        {
                            <li class="mb-2">
                                <strong>Última alteração:</strong><br>
                                <small class="text-muted">@Model.DataUltimaAlteracao.Value.ToString("dd/MM/yyyy HH:mm")</small>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}