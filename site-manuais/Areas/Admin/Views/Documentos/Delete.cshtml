@model site_manuais.Models.Documento

@{
    ViewData["Title"] = "Deletar Documento";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="display-4 text-danger">
                <i class="bi bi-exclamation-triangle"></i> Deletar Documento
            </h1>
            <p class="text-muted">Tem certeza que deseja deletar este documento?</p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="alert alert-danger" role="alert">
                <h5 class="alert-heading">
                    <i class="bi bi-exclamation-circle"></i> Atenção!
                </h5>
                <p>Esta ação é <strong>irreversível</strong>. O arquivo PDF será permanentemente excluído do servidor.</p>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Título:</dt>
                        <dd class="col-sm-9">
                            <i class="bi bi-file-pdf text-danger"></i>
                            @Model.Titulo
                        </dd>

                        <dt class="col-sm-3">Descrição:</dt>
                        <dd class="col-sm-9">@(Model.Descricao ?? "—")</dd>

                        <dt class="col-sm-3">Módulo:</dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-primary">@Model.Modulo.Nome</span>
                        </dd>

                        <dt class="col-sm-3">Categoria:</dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-info">@Model.Modulo.Categoria.Nome</span>
                        </dd>

                        <dt class="col-sm-3">Arquivo:</dt>
                        <dd class="col-sm-9">@Model.NomeArquivoOriginal</dd>

                        <dt class="col-sm-3">Tamanho:</dt>
                        <dd class="col-sm-9">
                            @{
                                var tamanhoKB = Model.TamanhoArquivo / 1024.0;
                                var tamanhoMB = tamanhoKB / 1024.0;
                                var tamanhoFormatado = tamanhoMB >= 1
                                ? $"{tamanhoMB:F2} MB"
                                : $"{tamanhoKB:F2} KB";
                            }
                            @tamanhoFormatado
                        </dd>

                        <dt class="col-sm-3">Enviado em:</dt>
                        <dd class="col-sm-9">@Model.DataUpload.ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>

                    <form asp-area="Admin" asp-controller="Documentos" asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-area="Admin" asp-controller="Documentos" asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Confirmar Exclusão
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>