@model IEnumerable<site_manuais.Models.Modulo>

@{
    ViewData["Title"] = "Módulos";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="display-4">
                <i class="bi bi-grid-3x3"></i> Módulos
            </h1>
            <p class="text-muted">Gerencie os módulos de cada categoria</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-12">
            <a asp-area="Admin" asp-controller="Modulos" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Criar Novo Módulo
            </a>
            <a asp-area="Admin" asp-controller="Categorias" asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Voltar para Categorias
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row">
            <div class="col-md-12">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Nome</th>
                                <th>Categoria</th>
                                <th>Descrição</th>
                                <th>Criado em</th>
                                <th>Última alteração</th>
                                <th class="text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.Nome</strong></td>
                                    <td>
                                        <span class="badge bg-info">@item.Categoria.Nome</span>
                                    </td>
                                    <td>@item.Descricao</td>
                                    <td>
                                        <small class="text-muted">
                                            <i class="bi bi-calendar-plus"></i>
                                            @item.DataCriacao.ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    </td>
                                    <td>
                                        @if (item.DataUltimaAlteracao.HasValue)
                                        {
                                            <small class="text-muted">
                                                <i class="bi bi-pencil-square"></i>
                                                @item.DataUltimaAlteracao.Value.ToString("dd/MM/yyyy HH:mm")
                                            </small>
                                        }
                                        else
                                        {
                                            <small class="text-muted">—</small>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-area="Admin" asp-action="Details" asp-route-id="@item.Id" 
                                               class="btn btn-sm btn-info" title="Ver Detalhes">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-area="Admin" asp-action="Edit" asp-route-id="@item.Id" 
                                               class="btn btn-sm btn-warning" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-area="Admin" asp-action="Delete" asp-route-id="@item.Id" 
                                               class="btn btn-sm btn-danger" title="Deletar">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i> 
            <strong>Nenhum módulo cadastrado.</strong> 
            Clique no botão acima para criar o primeiro módulo.
        </div>
    }
</div>
