@model site_manuais.Models.Documento

@{
    ViewData["Title"] = Model.Titulo;
}

<div class="container mt-5">
    <!-- BREADCRUMB -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Public" asp-action="Index">
                    <i class="bi bi-house"></i> Início
                </a>
            </li>
            <li class="breadcrumb-item">
                <a asp-controller="Public" asp-action="Categoria" asp-route-id="@Model.Modulo.CategoriaId">
                    @Model.Modulo.Categoria.Nome
                </a>
            </li>
            <li class="breadcrumb-item">
                <a asp-controller="Public" asp-action="Modulo" asp-route-id="@Model.ModuloId">
                    @Model.Modulo.Nome
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                @Model.Titulo
            </li>
        </ol>
    </nav>

    <!-- Título e informações do documento -->
    <div class="row">
        <div class="col-lg-8">
            <h2>@Model.Titulo</h2>

            @if (!string.IsNullOrEmpty(Model.Descricao))
            {
                <p class="text-muted mb-4">@Model.Descricao</p>
            }

            <!-- Botões de ação -->
            <div class="d-grid gap-2 d-md-block">
                <button id="btnToggleViewer" class="btn btn-primary btn-lg">
                    <i class="bi bi-eye"></i> <span id="btnToggleText">Visualizar PDF</span>
                </button>
                <a asp-controller="Public" asp-action="Download" asp-route-id="@Model.Id" class="btn btn-success btn-lg">
                    <i class="bi bi-download"></i> Download
                </a>
            </div>
        </div>

        <!-- Sidebar com informações adicionais -->
        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h5><i class="bi bi-info-circle"></i> Informações</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-6">
                            <small class="text-muted">Data de Upload:</small><br>
                            <strong>@Model.DataUpload.ToString("dd/MM/yyyy")</strong>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Tamanho:</small><br>
                            <strong>@((Model.TamanhoArquivo / 1024.0 / 1024.0).ToString("F2")) MB</strong>
                        </div>
                    </div>

                    <p class="mb-2">
                        <strong>Categoria:</strong><br>
                        <a asp-controller="Public" asp-action="Categoria" asp-route-id="@Model.Modulo.CategoriaId">
                            @Model.Modulo.Categoria.Nome
                        </a>
                    </p>
                    <p class="mb-2">
                        <strong>Módulo:</strong><br>
                        <a asp-controller="Public" asp-action="Modulo" asp-route-id="@Model.ModuloId">
                            @Model.Modulo.Nome
                        </a>
                    </p>
                    <p class="mb-0">
                        <strong>Arquivo:</strong><br>
                        <small>@Model.NomeArquivoOriginal</small>
                    </p>
                </div>
            </div>
        </div>

        <!-- Visualizador de PDF -->
        <div id="pdfViewer" class="row" style="display: none;">
            <div class="col-12">
                <div class="card">
                    <div class="card-body p-0">
                        <embed id="pdfEmbed" src="@Model.CaminhoArquivo" type="application/pdf" />
                    </div>
                </div>
            </div>
        </div>

        @section Scripts {
            <script>
                document.getElementById('btnToggleViewer').addEventListener('click', function () {
                    const viewer = document.getElementById('pdfViewer');
                    const btnText = document.getElementById('btnToggleText');
                    const btnIcon = this.querySelector('i');
                    const btn = this;

                    if (viewer.style.display === 'none') {
                        viewer.style.display = 'block';
                        btnText.textContent = 'Ocultar PDF';
                        btnIcon.className = 'bi bi-eye-slash';
                        btn.classList.remove('btn-primary');
                        btn.classList.add('btn-danger');
                        viewer.scrollIntoView({ behavior: 'smooth' });
                    } else {
                        viewer.style.display = 'none';
                        btnText.textContent = 'Visualizar PDF';
                        btnIcon.className = 'bi bi-eye';
                        btn.classList.remove('btn-danger');
                        btn.classList.add('btn-primary');
                    }
                });
            </script>
        }
    </div>
</div>