@model IEnumerable<site_manuais.Models.Categoria>

@{
    ViewData["Title"] = "Manuais e Documentação";
}

<div class="container mt-5">
    <!-- CABEÇALHO DA PÁGINA -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="display-4">
                <i class="bi bi-book"></i> Manuais e Documentação
            </h1>
            <p class="lead text-muted">
                Selecione uma categoria para visualizar os manuais disponíveis
            </p>
        </div>

        <!-- FORMULÁRIO DE BUSCA -->
        <div class="col-md-4">
            <form asp-controller="Public" asp-action="Buscar" method="get" class="mt-3">
                <div class="input-group">
                    <input type="text"
                           name="termo"
                           class="form-control"
                           placeholder="Buscar documentos..."
                           aria-label="Buscar">
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- VERIFICAR SE HÁ CATEGORIAS -->
    @if (Model.Any())
    {
        <!-- GRID DE CATEGORIAS -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var categoria in Model)
            {
                <div class="col">
                    <!-- CARD DA CATEGORIA -->
                    <div class="card h-100 shadow-sm hover-card">
                        <div class="card-body">
                            <h5 class="card-title">
                                <i class="bi bi-folder" style="color:@categoria.Cor"></i>
                                @categoria.Nome
                            </h5>

                            <!-- DESCRIÇÃO (SE EXISTIR) -->
                            @if (!string.IsNullOrEmpty(categoria.Descricao))
                            {
                                <p class="card-text text-muted">
                                    @categoria.Descricao
                                </p>
                            }

                            <!-- BADGE COM QUANTIDADE DE MÓDULOS -->
                            <div class="mb-3">
                                <span class="badge" style="background:@categoria.Cor; color:#fff;">
                                    @categoria.Nome
                                    @categoria.Modulos.Count
                                    @(categoria.Modulos.Count == 1 ? "módulo" : "módulos")
                                </span>
                            </div>

                            <!-- BOTÃO PARA VER MÓDULOS -->
                            <a asp-controller="Public"
                               asp-action="Categoria"
                               asp-route-id="@categoria.Id"
                               class="btn btn-primary w-100"
                               style="background:@categoria.Cor; color:#fff;">
                                <i class="bi bi-arrow-right-circle"></i>
                                Ver Módulos
                            </a>
                        </div>

                        <!-- RODAPÉ COM DATA DE CRIAÇÃO -->
                        <div class="card-footer bg-transparent">
                            <small class="text-muted">
                                <i class="bi bi-calendar-plus"></i>
                                Criado em @categoria.DataCriacao.ToString("dd/MM/yyyy")
                            </small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- MENSAGEM SE NÃO HOUVER CATEGORIAS -->
        <div class="alert alert-info" role="alert">
            <i class="bi bi-info-circle"></i>
            <strong>Nenhuma categoria cadastrada ainda.</strong>
            Aguarde enquanto o conteúdo é adicionado.
        </div>
    }
</div>

<!-- CSS CUSTOMIZADO PARA EFEITO HOVER -->
<style>
    .hover-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.2) !important;
    }
</style>