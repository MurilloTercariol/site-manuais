@{
    var isAdmin = ViewContext.RouteData.Values["area"]?.ToString() == "Admin";
}

<!DOCTYPE html>
<html lang="pt-BR" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TZ Soluções - Sistema de Manuais</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

@if (isAdmin) //ADMIN
{
<body class="admin-layout">
    <!-- NAVBAR ADMIN -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm fixed-top">
        <div class="container-fluid">
            <!-- HAMBURGER - trigger do hover -->
            <div class="sidebar-trigger me-3" id="sidebarTrigger">
                <i class="bi bi-list fs-4 text-white"></i>
            </div>

            <span class="navbar-brand fw-bold mb-0">
                <i class="bi bi-gear-fill text-warning me-2"></i>
                Painel Administrativo - TZ Soluções
            </span>

            <!-- MENU USUÁRIO -->
            <div class="navbar-nav ms-auto">
                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle text-light" href="#" id="userDropdown"
                       role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle me-1"></i>
                        @User.Identity.Name
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form method="post" action="/Account/Logout" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="bi bi-box-arrow-left me-2"></i> Sair
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- SIDEBAR OFF-CANVAS (fixa, escondida à esquerda) -->
    <aside class="admin-sidebar-offcanvas" id="sidebar" role="navigation" aria-label="Menu principal">
        <div class="sidebar-content p-3">
            <h6 class="text-white-50 text-uppercase small fw-bold mb-3">Menu Principal</h6>

            <a asp-area="Admin" asp-controller="Categorias" asp-action="Index"
               class="sidebar-link d-block text-decoration-none">
                <i class="bi bi-folder me-2"></i> Categorias
            </a>

            <a asp-area="Admin" asp-controller="Modulos" asp-action="Index"
               class="sidebar-link d-block text-decoration-none">
                <i class="bi bi-grid-3x3 me-2"></i> Módulos
            </a>

            <a asp-area="Admin" asp-controller="Documentos" asp-action="Index"
               class="sidebar-link d-block text-decoration-none">
                <i class="bi bi-file-earmark-pdf me-2"></i> Documentos
            </a>
               

            <hr class="my-3" style="border-color: rgba(255,255,255,0.2);">

            <h6 class="text-white-50 text-uppercase small fw-bold mb-3">Ações Rápidas</h6>

            <a asp-area="Admin" asp-controller="Categorias" asp-action="Create"
               class="sidebar-link d-block text-decoration-none">
                <i class="bi bi-plus-circle me-2"></i> Nova Categoria
            </a>

            <a asp-area="Admin" asp-controller="Documentos" asp-action="Create"
               class="sidebar-link d-block text-decoration-none">
                <i class="bi bi-cloud-upload me-2"></i> Upload Documento
            </a>
        </div>
    </aside>

    <!-- OVERLAY (para fechar clicando fora no mobile) -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- CONTEÚDO PRINCIPAL -->
    <main class="admin-main-content" id="mainContent">
        <div class="container-fluid p-4">
            <!-- BREADCRUMB -->
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"> 
                            <i class="bi bi-person"></i> Admin
                    </li>
                    @if (ViewData["Title"] != null)
                    {
                        <li class="breadcrumb-item active">@ViewData["Title"]</li>
                    }
                </ol>
            </nav>

            @RenderBody()
        </div>
    </main>
    


    <!-- FOOTER SEMPRE NO FINAL -->
    <footer class="bg-dark text-light py-4 mt-auto">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5><i class="bi bi-building me-2"></i>TZ Soluções</h5>
                    <p class="mb-2">Sistema de Gerenciamento de Manuais</p>
                    <small class="text-muted">
                        Desenvolvido para facilitar o acesso e organização de documentos técnicos.
                    </small>
                </div>

                <div class="col-md-3">
                    <h6>Links Úteis</h6>
                    <ul class="list-unstyled">
                        <li><a href="https://www.tzsolucoes.com.br/" class="text-light text-decoration-none">Sobre</a></li>
                        <li><a href="https://wa.me/16991589900?text=Olá,%20gostaria%20de%20falar%20com%20o%20suporte." class="text-light text-decoration-none">Suporte</a></li>
                    </ul>
                </div>

                <div class="col-md-3">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <h6>Área Administrativa</h6>
                        <p class="mb-1">
                            <i class="bi bi-person-check text-success me-1"></i>
                            Logado como: <strong>@User.Identity.Name</strong>
                        </p>
                        <small class="text-muted">
                            <i class="bi bi-clock me-1"></i>
                            Último acesso: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                        </small>
                    }
                    else
                    {
                        <h6>Área Administrativa</h6>
                        <a asp-controller="Account" asp-action="Login"
                           class="btn btn-outline-light btn-sm">
                            <i class="bi bi-shield-lock me-1"></i> Fazer Login
                        </a>
                    }
                </div>
            </div>

            <hr class="my-3">

            <div class="row align-items-center">
                <div class="col-md-6">
                    <small class="text-muted">
                        &copy; @DateTime.Now.Year TZ Soluções. Todos os direitos reservados.
                    </small>
                </div>
                <div class="col-md-6 text-md-end">
                    <small class="text-muted">
                        <i class="bi bi-code-slash me-1"></i>
                        Versão 1.1.0 | ASP.NET Core 8.0
                    </small>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Sidebar hover/toggle logic
        const sidebar = document.getElementById('sidebar');
        const trigger = document.getElementById('sidebarTrigger');
        const overlay = document.getElementById('sidebarOverlay');
        const mainContent = document.getElementById('mainContent');

        let hoverTimeout;

        function openSidebar() {
            sidebar.classList.add('open');
            overlay.classList.add('show');
            mainContent.classList.add('sidebar-open');
            clearTimeout(hoverTimeout);
        }

        function closeSidebar() {
            hoverTimeout = setTimeout(() => {
                sidebar.classList.remove('open');
                overlay.classList.remove('show');
                mainContent.classList.remove('sidebar-open');
            }, 150); // pequeno delay para permitir mover mouse do trigger para sidebar
        }

        // Hover no hamburger
        trigger.addEventListener('mouseenter', openSidebar);
        trigger.addEventListener('mouseleave', closeSidebar);

        // Hover na própria sidebar (mantém aberta)
        sidebar.addEventListener('mouseenter', openSidebar);
        sidebar.addEventListener('mouseleave', closeSidebar);

        // Clique no overlay fecha (mobile)
        overlay.addEventListener('click', closeSidebar);

        // Tecla ESC fecha
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeSidebar();
        });

        // Marcar link ativo
        document.addEventListener('DOMContentLoaded', function () {
            const currentPath = window.location.pathname;
            document.querySelectorAll('.sidebar-link').forEach(link => {
                if (currentPath.startsWith(link.getAttribute('href'))) {
                    link.classList.add('active');
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
}
