@{
    var isAdmin = ViewContext.RouteData.Values["area"]?.ToString() == "Admin";
}

<!DOCTYPE html>
<html lang="pt-BR" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TZ Soluções - Sistema de Manuais</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/site_manuais.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="d-flex flex-column h-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">
                <!-- LOGO/MARCA -->
                @if (isAdmin)
                {
                    <a class="navbar-brand fw-bold" href="/Admin/Categorias/Index">
                        <i class="bi bi-gear-fill text-white me-2"></i>
                        Admin - TZ Soluções
                    </a>
                }
                else
                {
                    <a class="navbar-brand fw-bold" href="/Public/Index">
                        <i class="bi bi-book me-2"></i>
                        TZ Soluções - Manuais
                    </a>
                }

                <!-- BOTÃO MOBILE -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarNav" aria-controls="navbarNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- MENU NAVEGAÇÃO -->
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                    </ul>

                    <!-- MENU ADMIN/LOGIN -->
                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <!-- USUÁRIO LOGADO -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="adminDropdown"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-gear me-1"></i>
                                    Admin: @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Categorias" asp-action="Index">
                                            <i class="bi bi-folder me-2"></i> Categorias
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Modulos" asp-action="Index">
                                            <i class="bi bi-grid-3x3 me-2"></i> Módulos
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Documentos" asp-action="Index">
                                            <i class="bi bi-file-earmark-pdf me-2"></i> Documentos
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/Public/Index" target="_blank">
                                            <i class="bi bi-globe me-2"></i> Ver Site Público
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" action="/Account/Logout" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> Sair
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <!-- USUÁRIO NÃO LOGADO -->
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-shield-lock me-1"></i> Admin
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- CONTEÚDO PRINCIPAL - FLEX GROW PARA OCUPAR ESPAÇO RESTANTE -->
    <main class="flex-grow-1">
        <div class="container-fluid px-0">
            @RenderBody()
        </div>
    </main>

    <!-- FOOTER SEMPRE NO FINAL -->
    <footer class="bg-dark text-light py-4 mt-auto">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5><i class="bi bi-building me-2"></i>TZ Soluções</h5>
                    <p class="mb-2">Sistema de Gerenciamento de Manuais</p>
                    <small class="text-muted">
                        Desenvolvido para facilitar o acesso e organização de documentos técnicos.
                    </small>
                </div>

                <div class="col-md-3">
                    <h6>Links Úteis</h6>
                    <ul class="list-unstyled">
                        <li><a href="https://www.tzsolucoes.com.br/" class="text-light text-decoration-none">Sobre</a></li>
                        <li><a href="https://wa.me/16991589900?text=Gostaria%20de%20falar%20com%20o%20suporte" class="text-light text-decoration-none">Suporte</a></li>
                    </ul>
                </div>

                <div class="col-md-3">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <h6>Área Administrativa</h6>
                        <p class="mb-1">
                            <i class="bi bi-person-check text-success me-1"></i>
                            Logado como: <strong>@User.Identity.Name</strong>
                        </p>
                        <small class="text-muted">
                            <i class="bi bi-clock me-1"></i>
                            Último acesso: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                        </small>
                    }
                    else
                    {
                        <h6>Área Administrativa</h6>
                        <a asp-controller="Account" asp-action="Login"
                           class="btn btn-outline-light btn-sm">
                            <i class="bi bi-shield-lock me-1"></i> Fazer Login
                        </a>
                    }
                </div>
            </div>

            <hr class="my-3">

            <div class="row align-items-center">
                <div class="col-md-6">
                    <small class="text-muted">
                        &copy; @DateTime.Now.Year TZ Soluções. Todos os direitos reservados.
                    </small>
                </div>
                <div class="col-md-6 text-md-end">
                    <small class="text-muted">
                        <i class="bi bi-code-slash me-1"></i>
                        Versão 1.0.0 | ASP.NET Core 8.0
                    </small>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>